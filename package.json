{
  "name": "chronovault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal music library and player with waveform, metadata and synced lyrics.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "local": "node scripts/stack.mjs local",
    "docker": "node scripts/stack.mjs docker",
    "stop": "node scripts/stack.mjs stop",
    "dev": "nuxt dev --port 3100",
    "build": "nuxt build",
    "preview": "nuxt preview --port 3100",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:migration": "supabase migration new",
    "db:lint": "supabase db lint --level warning",
    "db:types": "node scripts/gen-types.mjs",
    "db:push": "supabase db push",
    "env:local": "node scripts/setup-env.mjs",
    "generate:brand": "node scripts/generate-brand.mjs",
    "r2:check": "node scripts/check-r2.mjs",
    "merge:main": "node scripts/merge-main.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/supabase": "^2.1.0",
    "@pinia/nuxt": "^1.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/vue-virtual": "^3.13.48",
    "@vercel/analytics": "^2.0.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "aws4fetch": "^1.0.20",
    "browser-id3-writer": "6.4.0",
    "h3": "^1.15.11",
    "hash-wasm": "^4.12.0",
    "libflacjs": "^5.6.0",
    "music-metadata": "^12.2.3",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "wavesurfer.js": "^8.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/sortablejs": "^1.15.9",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@wasm-audio-decoders/flac": "^0.2.11",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
