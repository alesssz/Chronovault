# Dependencies and build output are recreated inside the image
node_modules
.pnpm-store
.nuxt
.output
.data
.nitro
.cache
dist

# Secrets and local environment (passed at runtime instead)
.env
.env.*

# Tests and tooling
coverage
playwright-report
test-results
blob-report
.vscode
.idea
.github
.git

# Not read by the build: documentation, tests, database migrations (applied
# by the Supabase CLI, never by the app), the brand's source artwork (the
# icons in public/ are generated from it). Kept out of the context so that
# editing them does not invalidate the image's install and build layers.
docs
test
supabase
brand
*.md
# The build's own files: Docker reads the Dockerfile anyway, and inside the
# context an edit to any of them would invalidate the build layers.
Dockerfile
.dockerignore
compose.yaml
Makefile
