# Editor settings shared by every IDE (https://editorconfig.org): UTF-8,
# LF, 2-space indentation; Markdown keeps trailing spaces (line breaks);
# the Makefile needs tabs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
