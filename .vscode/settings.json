{
  // Code style is enforced by ESLint (stylistic): no Prettier.
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  // The pnpm store lives in the project (see pnpm-workspace.yaml): keep it out of
  // file watching, search and the explorer.
  "files.watcherExclude": {
    "**/.pnpm-store/**": true
  },
  "search.exclude": {
    "**/.pnpm-store": true
  },
  "files.exclude": {
    "**/.pnpm-store": true
  },
  "python.terminal.useEnvFile": true
}
