# -----------------------------------------------------------------------------
# Cloudflare R2 — audio storage used in production.
# Copy this file to .env.r2 (git-ignored), fill it in, then run:  pnpm r2:check
# The same five variables go into the Vercel project settings.
# NEVER commit the real values: the secret key gives full access to the bucket.
# -----------------------------------------------------------------------------

# S3 API endpoint of your account: R2 → Overview → "Account details" → S3 API
NUXT_AUDIO_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Always "auto" for R2
NUXT_AUDIO_STORAGE_REGION=auto

# The bucket created for ChronoPlayer
NUXT_AUDIO_STORAGE_BUCKET=chronoplayer-audio

# R2 API token (Object Read & Write on this bucket only)
NUXT_AUDIO_STORAGE_ACCESS_KEY_ID=
NUXT_AUDIO_STORAGE_SECRET_ACCESS_KEY=
