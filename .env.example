# -----------------------------------------------------------------------------
# ChronoPlayer — environment variables
# Locally this file is generated with:  make env   (or: pnpm env:local)
# In production, set them in the Vercel dashboard.
# -----------------------------------------------------------------------------

# Supabase project URL (local: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321

# Public key (publishable / anon). Safe on the client: data is protected by
# the database RLS policies, not by keeping this key secret.
SUPABASE_KEY=

# Audio storage (S3-compatible). Server only: these never reach the browser.
# Locally: the S3 endpoint of the Supabase stack (written by `make env`).
# Production: Cloudflare R2, see .env.r2.example and README → Deployment.
NUXT_AUDIO_STORAGE_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
NUXT_AUDIO_STORAGE_REGION=local
NUXT_AUDIO_STORAGE_BUCKET=audio
NUXT_AUDIO_STORAGE_ACCESS_KEY_ID=
NUXT_AUDIO_STORAGE_SECRET_ACCESS_KEY=

# Statistics page (optional). Real visit numbers come from Vercel Web Analytics
# and exist only on the Vercel deployment: set these there (README → 13.6).
# Locally leave them unset: the page shows clearly flagged demo data.
# Server only: the token is a Vercel access token, never commit it.
# NUXT_ANALYTICS_TOKEN=
# NUXT_ANALYTICS_PROJECT_ID=
# NUXT_ANALYTICS_TEAM_ID=
